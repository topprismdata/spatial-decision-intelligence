# Byte-compiled / optimized / virtualenv
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/
dist/
build/

# Models & Heavy Checkpoints
models/
*.pth
*.pt
*.bin
*.safetensors
*.onnx

# Data Directories & Raw Excel Exports
data/
*.xlsx
*.xls
*.npz

# Generated Outputs & Large Artifacts (Keep markdown documentation)
outputs/*.csv
outputs/*.js
outputs/*.html
outputs/*.json
outputs/*.png
outputs/*.pth
outputs/*.pt

# Secrets & Local Configurations
.env
.env.*
*.secret

# IDE & OS Artifacts
.DS_Store
.workbuddy/
.idea/
.vscode/
*.swp

# Geographic data — compliance with 测绘法: no raw geo data on public hosting
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
outputs/
docs/archive_zh/

# never track geographic artifacts under docs/
docs/*.html
docs/*.png
docs/*.jpg
docs/screenshots/
